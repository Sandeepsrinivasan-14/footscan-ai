# Copy to .env and adjust. Every variable is optional; defaults live in backend/footscan/config.py.
# .env is git-ignored. Never commit real secrets.

# development | production. Production: JSON logs, no default CORS origins, Gradio dashboard off.
FOOTSCAN_ENVIRONMENT=development
FOOTSCAN_LOG_LEVEL=INFO
# auto (json in production, text otherwise) | json | text
FOOTSCAN_LOG_FORMAT=auto
FOOTSCAN_IMAGE_SIZE=256

# auto | cpu | cuda
FOOTSCAN_DEVICE=auto

# Path to the trained ResNet34-UNet checkpoint. Default: FootScan_AI_Core/footscan_best_model.pth
# inside the repo (fetch with `git lfs pull` or scripts/download_weights.py).
# FOOTSCAN_MODEL_WEIGHTS_PATH=/absolute/path/to/footscan_best_model.pth

# Storage. Defaults: ./data and a SQLite file inside it.
# FOOTSCAN_DATA_DIR=./data
# FOOTSCAN_DATABASE_URL=sqlite:///./data/footscan.db

# Require this value in an X-API-Key header on every /api/* call. Unset = no auth (local dev only).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# FOOTSCAN_API_KEY=

# Browser origins allowed by CORS: comma-separated, or a JSON array.
# Unset = localhost only in development, none (same-origin only) in production.
# FOOTSCAN_CORS_ORIGINS=https://app.example.org,https://admin.example.org

# Upload limits
# FOOTSCAN_MAX_UPLOAD_BYTES=15728640
# FOOTSCAN_MAX_IMAGE_PIXELS=40000000
# FOOTSCAN_MAX_IMAGE_SIDE=12000

# Requests per minute per client IP for /api/analyze and /api/compare. 0 disables.
# FOOTSCAN_RATE_LIMIT_PER_MINUTE=30

# Legacy Gradio dashboard at /dashboard (no API-key protection). Default: on in dev, off in production.
# FOOTSCAN_ENABLE_DASHBOARD=true
