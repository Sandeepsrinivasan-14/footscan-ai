# Copy to .env and adjust. All vars are optional; sensible defaults are in backend/footscan/config.py

FOOTSCAN_ENVIRONMENT=development
FOOTSCAN_LOG_LEVEL=INFO
FOOTSCAN_IMAGE_SIZE=256

# auto | cpu | cuda
FOOTSCAN_DEVICE=auto

# Absolute path to the trained ResNet34-UNet checkpoint
FOOTSCAN_MODEL_WEIGHTS_PATH=C:\Users\sndps\FootScan_AI\FootScan_AI_Core\footscan_best_model.pth

FOOTSCAN_DATA_DIR=C:\Users\sndps\FootScan_AI\data
FOOTSCAN_DATABASE_URL=sqlite:///C:/Users/sndps/FootScan_AI/data/footscan.db

# Leave unset to disable auth (fine for local dev). Set a real secret in production.
# FOOTSCAN_API_KEY=

# Comma-separated list is not supported by pydantic list parsing from env directly;
# set via .env as a JSON array instead, e.g. FOOTSCAN_CORS_ORIGINS=["https://your-frontend.example"]
# FOOTSCAN_CORS_ORIGINS=["*"]
