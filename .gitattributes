*.pth filter=lfs diff=lfs merge=lfs -text
*.hdf5 filter=lfs diff=lfs merge=lfs -text

# Keep line endings stable for files executed on Linux / checksummed
*.sh text eol=lf
*.sha256 text eol=lf
Dockerfile text eol=lf

# Vendored frontend libraries are hash-pinned (SRI): never rewrite their line endings.
frontend/vendor/** -text
frontend/js/** text eol=lf
frontend/css/** text eol=lf
